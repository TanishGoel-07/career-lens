# ==============================================================================
# CareerLens AI — Root Environment Configuration
# Copy this file to .env before starting the application.
# ==============================================================================

# Server & Runtime
NODE_ENV=development
PORT=3001

# Database (PostgreSQL with pgvector)
# Note: Host port 5433 is used by default in docker-compose to avoid host conflicts
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/careerlens

# Redis
# Note: Host port 6380 is used by default in docker-compose to avoid host conflicts
REDIS_URL=redis://localhost:6380

# Authentication & Security
JWT_ACCESS_SECRET=supersecret-careerlens-access-token-key-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# AI Providers (mock | gemini | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DAILY_TOKEN_BUDGET_PER_USER=100000
MOCK_EMBEDDINGS=true

# Resume Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_RESUME_UPLOAD_MB=8

# Code Execution Sandbox
SANDBOX_TIMEOUT_MS=8000
SANDBOX_MEMORY_MB=256

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
