# ==============================================================================
# CareerLens AI Career Intelligence Platform — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# PostgreSQL with pgvector (Mapped to port 5433 in docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/careerlens?schema=public"

# Redis Queue & Cache (Mapped to port 6380 in docker-compose.yml)
REDIS_URL="redis://localhost:6380"

# JWT Authentication
JWT_ACCESS_SECRET="careerlens_super_secret_jwt_access_key_2026_dev"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# AI Intelligence Engine ("mock", "gemini", or "openai")
AI_PROVIDER=mock
# GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
AI_DAILY_TOKEN_BUDGET_PER_USER=100000

# File Storage (Local disk or S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_RESUME_UPLOAD_MB=8

# Code Execution Sandbox
SANDBOX_TIMEOUT_MS=8000
SANDBOX_MEMORY_MB=256

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
