{
  "name": "career-lens",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @career-lens/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @career-lens/db exec prisma generate",
    "db:seed": "pnpm --filter @career-lens/db exec ts-node prisma/seed.ts",
    "api:dev": "pnpm --filter @career-lens/api start:dev",
    "job-worker:dev": "pnpm --filter @career-lens/job-worker start:dev",
    "sandbox-worker:dev": "pnpm --filter @career-lens/sandbox-worker start:dev"
  }
}
